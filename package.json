{
  "name": "rangefind",
  "version": "0.4.12",
  "description": "Range-packed static search for large sites with no search server.",
  "type": "module",
  "license": "MIT",
  "author": "Xavier Jodoin <xavier@jodoin.me>",
  "homepage": "https://rangefind.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xjodoin/rangefind.git"
  },
  "bugs": {
    "url": "https://github.com/xjodoin/rangefind/issues"
  },
  "keywords": [
    "search",
    "static-site",
    "static-search",
    "inverted-index",
    "bm25",
    "range-requests",
    "client-side-search",
    "browser-search",
    "serverless"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "rangefind": "./bin/rangefind.js"
  },
  "types": "./types/runtime.d.ts",
  "exports": {
    ".": {
      "types": "./types/runtime.d.ts",
      "default": "./src/runtime.js"
    },
    "./node": {
      "types": "./types/node.d.ts",
      "node": "./src/runtime.node.js",
      "default": "./src/node_only_entry.js"
    },
    "./mobile": {
      "types": "./types/mobile.d.ts",
      "default": "./src/runtime.mobile.js"
    },
    "./browser": {
      "types": "./types/runtime.d.ts",
      "default": "./dist/runtime.browser.js"
    },
    "./element": "./dist/rangefind-search.js",
    "./element.css": "./dist/rangefind-search.css",
    "./builder": {
      "types": "./types/builder.d.ts",
      "node": "./src/builder.js",
      "default": "./src/node_only_entry.js"
    },
    "./crawler": {
      "node": "./src/crawler.js",
      "default": "./src/node_only_entry.js"
    },
    "./osm": {
      "types": "./types/osm.d.ts",
      "default": "./src/integrations/osm/index.js"
    },
    "./osm/node": {
      "types": "./types/osm-node.d.ts",
      "node": "./src/integrations/osm/node/builder.js",
      "default": "./src/node_only_entry.js"
    },
    "./osm/extract": {
      "types": "./types/osm-node.d.ts",
      "node": "./src/integrations/osm/node/extract.js",
      "default": "./src/node_only_entry.js"
    },
    "./shards": {
      "types": "./types/shards.d.ts",
      "node": "./src/index_shards.js",
      "default": "./src/node_only_entry.js"
    },
    "./route": {
      "types": "./types/route.d.ts",
      "default": "./src/route_graph_query.js"
    },
    "./route/node": {
      "types": "./types/route.d.ts",
      "node": "./src/route_graph_node.js",
      "default": "./src/node_only_entry.js"
    },
    "./route/build": {
      "node": "./src/route_graph_build.js",
      "default": "./src/node_only_entry.js"
    },
    "./pulsemesh": {
      "types": "./types/pulsemesh.d.ts",
      "default": "./src/pulsemesh/index.js"
    },
    "./pulsemesh/mobile": {
      "types": "./types/pulsemesh-mobile.d.ts",
      "default": "./src/pulsemesh/mobile.js"
    },
    "./pulsemesh/threads": {
      "types": "./types/pulsemesh-threads.d.ts",
      "default": "./src/pulsemesh/threads.js"
    },
    "./pulsemesh/lora": {
      "types": "./types/pulsemesh-lora.d.ts",
      "default": "./src/pulsemesh/lora.js"
    },
    "./pulsemesh/bridge": {
      "types": "./types/pulsemesh-bridge.d.ts",
      "default": "./src/pulsemesh/bridge.js"
    },
    "./pulsemesh/libp2p": {
      "types": "./types/pulsemesh-libp2p.d.ts",
      "node": "./src/pulsemesh/libp2p.js",
      "default": "./src/node_only_entry.js"
    },
    "./scoring-stats": {
      "types": "./types/scoring-stats.d.ts",
      "node": "./src/scoring_stats.js",
      "default": "./src/node_only_entry.js"
    },
    "./config": {
      "types": "./types/config.d.ts",
      "node": "./src/config.js",
      "default": "./src/node_only_entry.js"
    },
    "./qr": {
      "default": "./src/qr.js"
    },
    "./analysis": "./src/analysis.js",
    "./terms": "./src/terms.js",
    "./link-graph": "./src/link_graph.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "dist/",
    "types/",
    "src/",
    "docs/",
    "scripts/",
    "examples/basic/docs.jsonl",
    "examples/basic/rangefind.config.json",
    "examples/basic/public/index.html",
    "examples/basic/public/component.html",
    "examples/basic/public/component-tailwind.html",
    "examples/frwiki/README.md",
    "examples/wiki-search/README.md",
    "examples/wiki-search/package.json",
    "examples/wiki-search/scripts/build.mjs",
    "examples/wiki-search/public/index.html",
    "examples/wiki-search/public/styles.css",
    "examples/wiki-search/public/app.js",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "examples/osm-geo/README.md",
    "examples/osm-geo/google-maps-adapter.js",
    "examples/osm-geo/public/index.html",
    "examples/osm-geo/public/app.js",
    "examples/osm-geo/public/styles.css",
    "examples/wiki-search/scripts/embed.mjs",
    "CHANGELOG.md",
    "!scripts/tantivy_quality",
    "!scripts/lucene_quality"
  ],
  "scripts": {
    "build:browser": "node scripts/build_browser_bundle.mjs",
    "build:osm-demo": "npm run build:browser && cp dist/runtime.browser.js dist/osm.browser.js dist/route.browser.js dist/pulsemesh.browser.js dist/pulsemesh-threads.browser.js dist/pulsemesh-libp2p.browser.js dist/qr.browser.js examples/osm-geo/public/",
    "setup:osm-demo-route": "node scripts/osm_demo_route_setup.mjs",
    "build:element": "node scripts/build_element_bundle.mjs",
    "build:example": "node scripts/build_browser_bundle.mjs && node bin/rangefind.js build --config examples/basic/rangefind.config.json && cp dist/runtime.browser.js examples/basic/public/runtime.browser.js",
    "build:wiki-site": "npm run build:browser && node examples/wiki-search/scripts/build.mjs",
    "build:wiki-site:full": "npm run build:browser && node examples/wiki-search/scripts/build.mjs --limit=0 --multistream=3",
    "build:wiki-site:fr:full": "npm run build:browser && node examples/wiki-search/scripts/build.mjs --dump-url=https://dumps.wikimedia.org/frwiki/latest/frwiki-latest-pages-articles.xml.bz2 --wiki=frwiki --limit=0 --multistream=3",
    "serve:example": "node scripts/serve.mjs examples/basic/public 5178",
    "serve:wiki-site": "node scripts/serve.mjs examples/wiki-search/public 5182",
    "serve:osm-geo": "node scripts/serve.mjs examples/osm-geo/public 5184",
    "bench:quality": "npm run build:example && node scripts/bench_quality.mjs",
    "bench:performance": "npm run build:example && node scripts/bench_performance.mjs",
    "bench:matrix": "node scripts/bench_matrix.mjs",
    "bench:directories": "node scripts/bench_directory_layouts.mjs",
    "bench:frwiki": "node scripts/frwiki_fixture.mjs all",
    "bench:osm-geo": "node scripts/osm_fixture.mjs all --region=luxembourg && node scripts/osm_geo_bench.mjs --root=examples/osm-geo",
    "bench:osm-address": "node scripts/osm_fixture.mjs all --region=luxembourg && node scripts/osm_address_bench.mjs --root=examples/osm-geo",
    "bench:osm-maps": "node scripts/osm_maps_bench.mjs",
    "bench:osm-maps:edge": "node scripts/osm_maps_bench.mjs --profile=edge --strict",
    "bench:osm-maps:full": "node scripts/osm_maps_bench.mjs --profile=full",
    "bench:osm-maps:production": "node scripts/osm_maps_bench.mjs --profile=production --strict",
    "bench:osm-maps:next-index": "node scripts/osm_maps_bench.mjs --profile=next-index --strict",
    "bench:osm-maps:reverse": "node scripts/osm_maps_bench.mjs --profile=reverse-geocode --strict",
    "bench:osm-maps:list": "node scripts/osm_maps_bench.mjs --list",
    "bench:suggest": "node scripts/osm_fixture.mjs all --region=luxembourg && node scripts/suggest_bench.mjs --root=examples/osm-geo",
    "bench:vectors": "node scripts/vector_bench.mjs",
    "bench:link-rank": "node scripts/link_rank_bench.mjs",
    "bench:link-rank-query": "node scripts/link_rank_query_bench.mjs",
    "bench:link-rank-geo": "node scripts/link_rank_geo_bench.mjs",
    "bench:link-rank-quality": "node scripts/link_rank_quality.mjs",
    "bench:wiki-link-rank": "node scripts/wiki_linkrank_real.mjs",
    "bench:osm-geo:quebec": "node scripts/osm_fixture.mjs all --region=quebec && node scripts/osm_geo_bench.mjs --root=examples/osm-geo",
    "bench:osm-shards": "node scripts/osm_fixture.mjs jsonl --region=quebec --no-rqa && node scripts/osm_shard_bench.mjs --root=examples/osm-geo --shards=4",
    "bench:osm-geo:us": "node scripts/osm_us_bench.mjs",
    "bench:geo-builder": "node scripts/geo_builder_bench.mjs",
    "bench:pulsemesh": "node scripts/pulsemesh_bench.mjs",
    "bench:pulsemesh:sim": "node scripts/pulsemesh_sim.mjs --scenario=all",
    "bench:pulsemesh:wire": "node scripts/pulsemesh_wire_bench.mjs",
    "bench:pulsemesh:bond": "node scripts/pulsemesh_bond_bench.mjs",
    "bench:pulsemesh:threads": "node scripts/pulsemesh_thread_bench.mjs",
    "bench:pulsemesh:all": "node scripts/pulsemesh_bench.mjs && node scripts/pulsemesh_sim.mjs --scenario=all && node scripts/pulsemesh_wire_bench.mjs && node scripts/pulsemesh_thread_bench.mjs && node scripts/pulsemesh_bond_bench.mjs",
    "demo:pulsemesh": "node scripts/pulsemesh_demo.mjs",
    "pulsemesh:keeper": "node scripts/pulsemesh_keeper.mjs",
    "bench:frwiki:quality": "node scripts/frwiki_quality.mjs",
    "bench:frwiki:lucene-quality": "node scripts/frwiki_lucene_quality.mjs",
    "bench:frwiki:search-game": "node scripts/search_benchmark_game.mjs",
    "bench:frwiki:search-game-profile": "node scripts/search_benchmark_game_profile.mjs",
    "check": "for f in bin/rangefind.js src/*.js src/pulsemesh/*.js src/integrations/osm/*.js src/integrations/osm/node/*.js scripts/*.mjs test/*.js dist/*.js examples/wiki-search/scripts/*.mjs examples/wiki-search/public/*.js examples/osm-geo/public/*.js; do [ -e \"$f\" ] && node --check \"$f\"; done",
    "check:seo": "node scripts/check_site_seo.mjs",
    "test": "node --test test/*.test.js",
    "test:smoke": "npm run build:browser && npm run build:example && node scripts/smoke.mjs",
    "test:all": "npm run build:browser && npm run build:element && npm run check && npm test && npm run test:smoke",
    "prepublishOnly": "npm run test:all"
  },
  "devDependencies": {
    "@chainsafe/libp2p-gossipsub": "^14.1.2",
    "@chainsafe/libp2p-noise": "^16.1.5",
    "@chainsafe/libp2p-yamux": "^7.0.4",
    "@libp2p/circuit-relay-v2": "^3.2.24",
    "@libp2p/identify": "^3.0.39",
    "@libp2p/kad-dht": "^14.2.15",
    "@libp2p/tcp": "^10.1.19",
    "@libp2p/webrtc": "^5.2.24",
    "@libp2p/websockets": "^9.2.19",
    "esbuild": "^0.25.12",
    "libp2p": "^2.10.0",
    "multiformats": "^13.4.2",
    "rangefind": "file:."
  },
  "peerDependencies": {
    "@chainsafe/libp2p-gossipsub": "^14.1.2",
    "@chainsafe/libp2p-noise": "^16.1.5",
    "@chainsafe/libp2p-yamux": "^7.0.4",
    "@libp2p/identify": "^3.0.39",
    "@libp2p/tcp": "^10.1.19",
    "libp2p": "^2.10.0"
  },
  "peerDependenciesMeta": {
    "@chainsafe/libp2p-gossipsub": {
      "optional": true
    },
    "@chainsafe/libp2p-noise": {
      "optional": true
    },
    "@chainsafe/libp2p-yamux": {
      "optional": true
    },
    "@libp2p/identify": {
      "optional": true
    },
    "@libp2p/tcp": {
      "optional": true
    },
    "libp2p": {
      "optional": true
    }
  },
  "workspaces": [
    "packages/*",
    "site"
  ]
}
