<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Car app: drawing our own map needs the surface, and the navigation
         and map template families are what a routing app is allowed to use. -->
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />
    <uses-permission android:name="androidx.car.app.MAP_TEMPLATES" />

    <!-- Android Auto: a navigation-category car app. -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="false" />
    <uses-feature
        android:name="android.software.car.templates_host"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Wayfind">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Wayfind"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A shared drive is a link, and a link has to open something.
                 The capability lives in the fragment, which is never sent to
                 rangefind.dev on the web and is handed to us intact here, so
                 opening one in Wayfind means no server sees it at any point
                 on either path. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="rangefind.dev" android:pathPrefix="/t" />
                <!-- A dispatched job (threads §20). Same shape, different
                     capability: /t lets you watch a run, /j lets you take
                     one, and the app branches on the artifact rather than
                     on the path it arrived by. -->
                <data android:scheme="https" android:host="rangefind.dev" android:pathPrefix="/j" />
            </intent-filter>
            <!-- The same capabilities without depending on a domain at all.
                 This is also the handover path: the next driver's own camera
                 app fires ACTION_VIEW on the QR this phone displays, which
                 is why there is no scanner anywhere in this app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="wayfind" android:host="thread" />
                <data android:scheme="wayfind" android:host="ticket" />
                <!-- A device card (threads §20.9). Enrolment is the gate on
                     transfer — a job can only be sealed to a device this
                     phone already holds the public key of — so the other
                     driver shows their card and this phone's camera opens
                     it here. Same carrier as everything else: base64url in
                     the fragment, which is never transmitted. -->
                <data android:scheme="wayfind" android:host="device" />
                <!-- A job offer (threads §20.4). The one artifact here that
                     is public and unsealed by design: it goes to strangers,
                     so it carries a commitment and coarse descriptors and
                     no address at all. It arrives the way a stranger's
                     artifact does — a QR in a depot, a line in a group
                     chat — and the system camera fires ACTION_VIEW on it,
                     which is why there is no scanner in this app. -->
                <data android:scheme="wayfind" android:host="offer" />
            </intent-filter>
            <!-- A plan bigger than a camera can scan travels as a file, and
                 a file reaches an app by being shared into it: a dispatcher
                 mails the ticket and the driver picks Wayfind from the
                 share sheet. The link may arrive as the mail body or as the
                 attachment, so both are read. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- The same ticket saved to Downloads and tapped there. File
                 managers label a .wayfindjob by whatever the server said,
                 which is text/plain when it was honest and
                 application/octet-stream when it had no idea. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="text/plain" />
                <data android:scheme="content" android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <service
            android:name=".nav.NavigationService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <service
            android:name=".car.WayfindCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>
            <!-- "Navigate to X" from Assistant or another app. A navigation
                 app is required to handle this; without it Wayfind can be
                 opened but never targeted. -->
            <intent-filter>
                <action android:name="androidx.car.app.action.NAVIGATE" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="geo" />
            </intent-filter>
        </service>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.traces"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- Handed-over tickets, and only those. A second authority rather
             than another path on the trace provider: the grant a share
             hands out is per-authority, and a driver mailing a ticket has
             no business widening what a trace share could reach. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.tickets"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/ticket_paths" />
        </provider>

    </application>
</manifest>
