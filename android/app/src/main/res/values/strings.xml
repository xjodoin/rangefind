         What is still true is the other half: whoever opens it publishes
         this vehicle. -->
    <string name="mesh_handover_warning">Only %1$s can open this. Point that phone\'s camera at it — that device then becomes the publisher, so stop driving this job on this one.</string>
    <string name="mesh_handover_close">Close</string>
    <string name="mesh_handover_unavailable">There is no job to hand over.</string>
    <!-- Enrolment is the gate on transfer, so an empty roster is not a
         failure to report: it is a missing prerequisite to name. -->
    <string name="mesh_handover_no_devices">No device is enrolled yet, and a job is sealed to one device or to nobody. The other driver opens Wayfind, shows their device card, and this phone opens it — then the job can be handed over.</string>
    <string name="mesh_handover_pick_title">Hand over to which device?</string>
    <string name="mesh_handover_pick_note">The job is sealed to the device you pick, and no other phone can open it.</string>
    <string name="mesh_handover_pick_cancel">Cancel</string>
    <!-- The two refusals §20.9 keeps apart, because they have different
         fixes: one is enrolment, the other is a fresh ticket. -->
    <string name="mesh_job_sealed_elsewhere">This job was sealed for another device. Ask the dispatcher to enrol this device and send it again.</string>
    <string name="mesh_job_unsealed">This job arrived unsealed, so anyone who handled it can read the addresses and publish the vehicle. Ask the dispatcher to enrol this device and send a sealed job.</string>
    <string name="mesh_job_no_device_key">This phone has no device identity yet, so a sealed job cannot be opened here.</string>

    <!-- Device identity and enrolment (threads §20.9). -->
    <string name="device_section_title">This device</string>
    <string name="device_section_note">A job travels encrypted and is sealed to one device. Show this card to the other driver\'s camera, and open theirs the same way, before either of you can hand a job over.</string>
    <string name="device_name_label">Name on the card</string>
    <string name="device_name_hint">e.g. Léa — Pixel 8</string>
    <string name="device_fingerprint_label">Fingerprint</string>
    <string name="device_fingerprint_note">Read these characters aloud and check they match the other phone. A card is just bytes on a screen; that comparison is what enrolment is worth.</string>
    <string name="device_show_card">Show my device card</string>
    <string name="device_card_title">My device card</string>
    <string name="device_card_share">Send this card</string>
    <string name="device_card_share_chooser">Send your device card</string>
    <string name="device_card_close">Close</string>
    <string name="device_card_unavailable">This phone has no device identity yet.</string>
    <string name="device_card_unreadable">That device card cannot be read — ask them to show it again.</string>
    <string name="device_unnamed">Unnamed device</string>
    <string name="device_enrol_title">Enrol this device?</string>
    <string name="device_enrol_note">Check this fingerprint matches what the other phone is showing right now. Anyone can put a card on a screen; this comparison is the only thing that says it is theirs.</string>
    <string name="device_enrol_confirm">Enrol</string>
    <string name="device_enrol_cancel">Cancel</string>
    <string name="device_enrolled_notice">%1$s can now be handed a job.</string>
    <string name="device_roster_title">Devices you can hand a job to</string>
    <string name="device_roster_empty">None yet. A job cannot be handed on until a device is enrolled.</string>
    <string name="device_forget">Remove</string>
    <string name="device_added_at">Enrolled %1$s</string>
    <!-- The one loss this design cannot recover from, said before it
         happens rather than after. -->
    <string name="device_key_loss_note">This key never leaves the phone. Reinstalling Wayfind or clearing its data destroys it: every job already sealed to this device stops opening, and the dispatcher has to enrol this phone again.</string>
    <string name="device_key_plain">Stored without hardware protection on this phone.</string>
    <string name="mesh_handover_too_big">This plan is bigger than a camera can scan. Send the ticket as a file instead — it carries the same job.</string>
    <string name="mesh_handover_stop_note">The other phone is publishing this vehicle now, so this one says nothing on the way out: a goodbye from here would tell every customer the run had ended.</string>
    <string name="mesh_handover_stop_here">They have it — stop publishing here</string>
    <string name="mesh_handover_stopped_notice">Stopped publishing here. The other phone is driving this job now.</string>
    <string name="mesh_handover_share">Share ticket</string>
    <string name="mesh_handover_share_chooser">Hand over the ticket</string>

    <!-- Job offers (threads §20.4). An offer is the one artifact on this
         channel that is public and unsealed by design: it goes to couriers
         the dispatcher has never met, so it carries a commitment to a plan
         plus coarse descriptors and no address at all. Every line here has
         to stay inside what the bytes say — there is no stop in an offer to
         name, and the locality is a grid cell rather than a place. -->
    <string name="offer_title">A job on offer</string>
    <plurals name="offer_stops">
        <item quantity="one">%1$d stop</item>
        <item quantity="other">%1$d stops</item>
    </plurals>
    <string name="offer_distance">%1$s in total</string>
    <string name="offer_pay">%1$s for the round</string>
    <string name="offer_pay_unstated">No pay stated in this offer.</string>
    <string name="offer_label">“%1$s”</string>
    <string name="offer_expires">Offer valid until %1$s</string>
    <string name="offer_issuer">Offered by %1$s</string>
    <string name="offer_locality">Around %1$s</string>
    <!-- The grid is stated because a coordinate without its resolution
         reads as a position. It is the mean of the stops snapped to a
         0.01° grid: a point usually with nothing at it. -->
    <string name="offer_locality_grid">A grid square about %1$s km across, not an address — the point is the middle of the round and usually has nothing at it.</string>
    <string name="offer_spread_1km">Stops range within about 1 km of that point.</string>
    <string name="offer_spread_3km">Stops range within about 3 km of that point.</string>
    <string name="offer_spread_10km">Stops range within about 10 km of that point.</string>
    <string name="offer_spread_30km">Stops range within about 30 km of that point.</string>
    <string name="offer_spread_beyond">Stops range more than 30 km from that point.</string>
    <string name="offer_no_addresses">The addresses are not in this offer. They arrive only if this job is awarded to this device.</string>
    <string name="offer_send_card">Send my device card</string>
    <string name="offer_send_card_note">This protocol carries no bidding channel. Your card goes over whatever channel the dispatcher already uses; if they pick you, they seal the job to this device.</string>
    <string name="offer_dismiss">Dismiss</string>
    <string name="offer_unusable">This offer does not check out: %1$s</string>
    <string name="offer_unreadable">That job offer cannot be read — ask the dispatcher to post a fresh one.</string>
    <string name="offer_bid_sent">Card sent. This offer is kept here, so the job you are awarded can be checked against it.</string>
    <string name="offer_held_title">Jobs you have bid on</string>
    <string name="offer_held_empty">None. Sending your device card for an offer records it here, and whatever you are awarded afterwards is checked against it.</string>
    <string name="offer_held_bid_at">Card sent %1$s</string>
    <string name="offer_held_expires">Valid until %1$s</string>
    <string name="offer_forget">Remove</string>
    <!-- What the courier\'s own device makes of an award, given what they
         bid on (§20.4). The three cases are deliberately not one: a
         mismatched commitment on the same job id is refused, an award
         matching none of the open bids is warned about because a second
         unrelated dispatch looks exactly the same, and a check that
         passed is said out loud rather than left silent. -->
    <string name="offer_award_matches">This is the job you bid on — same plan, same issuer.</string>
    <string name="offer_award_mismatch">This is not the job you bid on: %1$s. It will not be taken.</string>
    <string name="offer_award_mismatch_unnamed">This is not the job you bid on, and the check that failed was not named. It will not be taken.</string>
    <plurals name="offer_award_unknown">
        <item quantity="one">This award matches none of the %1$d offer you bid on. That is what a swapped plan looks like — and also what a second, unrelated job looks like. Check with the dispatcher before accepting.</item>
        <item quantity="other">This award matches none of the %1$d offers you bid on. That is what a swapped plan looks like — and also what a second, unrelated job looks like. Check with the dispatcher before accepting.</item>
    </plurals>
    <string name="offer_award_refused">Refused: this award is not the job that was offered (%1$s).</string>
</resources>
