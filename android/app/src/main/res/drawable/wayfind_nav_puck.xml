<!--
  The vehicle, as MapLibre's location component draws it in GPS render mode.

  It has to be a drawable resource rather than the bitmap the symbol layer used,
  because the component takes a resource id and renders the puck itself. The
  shape is the same chevron: nose forward, notched tail, white outline so it
  reads against both a pale basemap and a dark one, over a soft shadow that
  keeps it separated from the road beneath it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="60dp"
    android:height="60dp"
    android:viewportWidth="60"
    android:viewportHeight="60">
    <path
        android:fillColor="#1A000000"
        android:pathData="M30,31 m-20,0 a20,20 0,1 1,40 0 a20,20 0,1 1,-40 0" />
    <path
        android:fillColor="#1573D6"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineJoin="round"
        android:pathData="M30,6 L48.7,49.7 L30,38.6 L11.3,49.7 Z" />
</vector>
